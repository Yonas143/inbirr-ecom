# Run pnpm setup to generate .env with fresh secrets. Never commit .env.
PAYLOAD_SECRET=
DATABASE_URL=postgres://postgres:localdev@127.0.0.1:5434/inbirr_ecom
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
PREVIEW_SECRET=
NEXT_PUBLIC_STORE_NAME=Inbirr Ecom
NEXT_PUBLIC_STORE_TAGLINE=Open commerce. Your way.
MCP_ENABLED=true
# Enable demo seeding only in development. Never enable on a live store.
ENABLE_DEMO_SEED=false
# local = optional filesystem media; hosted = set a Vercel Blob token
BLOB_READ_WRITE_TOKEN=
# Optional Postgres root CA (PEM). Certificate validation remains enabled.
DATABASE_SSL_CA=
# Optional Stripe integration. Leave blank until configured.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOKS_SIGNING_SECRET=
# Geo routing is optional; Chapa integration is not implemented yet.
PAYMENT_GEO_ROUTING=false

# Set false in development after applying migrations, to skip schema push.
DATABASE_PUSH=true
